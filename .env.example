DATABASE_URL=
ENCRYPTION_KEY=
JWT_SECRET=
PORT=3000

# Public URLs used in verification links and email action buttons.
BACKEND_PUBLIC_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:5173

# Gmail delivery channel. In-app notifications remain the source of truth.
EMAIL_NOTIFICATIONS_ENABLED=false
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=

# Adaptive/proactive sweep. Important events also trigger recalculation immediately.
ADAPTIVE_ENGINE_ENABLED=true
ADAPTIVE_ENGINE_INTERVAL_MINUTES=60
